# Server configuration. Keep SESSION_SECRET stable across upgrades.
APP_URL=https://crm.domainanda.com
SESSION_SECRET=

# First install only: seed the admin account (password 12+ characters).
ADMIN_EMAIL=admin@domainanda.com
ADMIN_PASSWORD=

# Optional migration seeds. After first startup, manage these in Settings.
MAILKETING_API_TOKEN=
WEBHOOK_SECRET=
CRM_API_TOKEN=
MCP_API_TOKEN=
FROM_NAME=Nama Bisnis Anda
FROM_EMAIL=news@domainanda.com
BUSINESS_ADDRESS=Alamat lengkap bisnis Anda
